# Copy to .env and use a disposable PostgreSQL database with TPC-DS data.
AGENTDB_URL=postgres://postgres:postgres@127.0.0.1:55432/tpcds
# Optional integration-test server. The role needs CREATEDB, not SUPERUSER.
# The test creates an isolated database and drops it after execution.
AGENTDB_TEST_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres

# Optional: required only for the corresponding real LLM provider.
# Each OpenAI-compatible profile reads its own <PREFIX>_* variables, so all keys can
# live here at once and experiments switch with --agent / --extractor / --provider.
# Profile `openai`: any OpenAI-compatible service.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_THINKING=
# Profile `deepseek`: official DeepSeek API (base URL defaults to https://api.deepseek.com).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONING_EFFORT=max
DEEPSEEK_THINKING=enabled
# Profile `zhipu`: official Zhipu BigModel API (base URL defaults to https://open.bigmodel.cn/api/paas/v4).
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.3
ZHIPU_REASONING_EFFORT=medium
ZHIPU_THINKING=enabled
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
