        "sql": "WITH per_year AS (\n  SELECT d.d_year,\n         SUM(ss.ss_net_paid) AS net_paid_sum,\n         SUM(r.sr_return_amt) AS return_sum\n  FROM store_sales ss\n  JOIN date_dim d ON ss.ss_sold_date_sk = d.d_date_sk\n  LEFT JOIN store_returns r\n    ON r.sr_ticket_number = ss.ss_ticket_number\n   AND r.sr_item_sk = ss.ss_item_sk\n  WHERE d.d_moy = 6 AND d.d_year IN (2001, 2002)\n  GROUP BY d.d_year\n)\nSELECT\n  ROUND((SELECT return_sum / net_paid_sum * 100 FROM per_year WHERE d_year = 2002)\n      - (SELECT return_sum / net_paid_sum * 100 FROM per_year WHERE d_year = 2001), 2) AS diff\n-- 2002年6月退货率 23.81975% - 2001年6月退货率 23.80983% = 0.00992 → 0.01",
