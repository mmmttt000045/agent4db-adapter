        "sql": "WITH ret AS (\n  SELECT DISTINCT sr_ticket_number, sr_item_sk, sr_return_amt\n  FROM store_returns\n)\nSELECT d.d_moy AS month,\n       100.0 * SUM(r.sr_return_amt) / SUM(s.ss_net_paid) AS return_rate_pct\nFROM store_sales s\nJOIN date_dim d ON s.ss_sold_date_sk = d.d_date_sk\nLEFT JOIN ret r\n  ON r.sr_ticket_number = s.ss_ticket_number\n AND r.sr_item_sk = s.ss_item_sk\nWHERE d.d_year = 2001\nGROUP BY d.d_moy\nORDER BY return_rate_pct DESC;",
