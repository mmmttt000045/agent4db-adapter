                "name": "门店退货率#2",
                "time": {
                  "dim": "date_dim",
                  "dim_col": "d_date_sk",
                  "fact_col": "ss_sold_date_sk",
                  "grain": "day",
                  "loss_ratio": 0.010305000000000009,
                  "role": "销售日"
                }
              },
