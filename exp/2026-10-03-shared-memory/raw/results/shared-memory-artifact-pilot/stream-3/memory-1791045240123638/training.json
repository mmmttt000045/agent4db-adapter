      "sql": "WITH feb_sales AS (\n  SELECT ss.ss_ticket_number, ss.ss_item_sk, ss.ss_net_paid\n  FROM store_sales ss\n  JOIN date_dim d ON d.d_date_sk = ss.ss_sold_date_sk\n  WHERE d.d_year = 2001 AND d.d_moy = 2\n)\nSELECT ROUND(\n  (SELECT SUM(r.sr_return_amt) FROM store_returns r\n   JOIN feb_sales f ON f.ss_ticket_number = r.sr_ticket_number AND f.ss_item_sk = r.sr_item_sk)\n  / (SELECT SUM(f.ss_net_paid) FROM feb_sales f) * 100, 2) AS return_rate_pct;",
