      "G|metric:门店退货率": {
        "consumers": [
          "producer-1-3"
        ],
        "content": {
          "Metric": {
            "aliases": [
              "门店退货率（%）",
              "store return rate"
            ],
            "basis": {
              "kind": "explicit_question",
              "task": "M3-L1"
            },
            "caveats": [
              "store_sales LEFT JOIN store_returns 的未匹配比例约为 60.41%，未匹配销售行的退货金额按 NULL 处理，SUM 会忽略，不影响销售额分母。",
              "store_sales INNER JOIN date_dim 的丢行比例约为 1.03%，无有效销售日期的销售行无法归属期间，不参与统计。",
              "已验证 store_sales 与 store_returns 按小票号+商品键为 1:1，因此直接关联即可，不需要对退货金额额外去重。",
              "退货金额按销售日期归属期间，不使用 store_returns 上的退货日期过滤。"
            ],
            "definition": "期间内售出的门店销售行所对应的退货金额之和 ÷ 这些销售行的净支付额之和 × 100；按销售日期归属期间，退货按小票号和商品与销售行对应，每笔退货只计一次，结果保留两位小数。",
            "empty": "unspecified",
            "examples": [
              {
                "question": "2001 年 2 月的门店退货率是多少？口径：门店退货率（%）= 期间内售出的门店销售行所对应的退货金额（sr_return_amt）之和 ÷ 这些销售行的净支付额（ss_net_paid）之和 × 100；按销售日期归属期间，退货按小票号和商品与销售行对应，每笔退货只计一次。保留两位小数。",
                "sql": "SELECT\n  ROUND(SUM(sr.sr_return_amt) / SUM(ss.ss_net_paid) * 100, 2) AS return_rate_pct\nFROM store_sales ss\nJOIN date_dim d ON ss.ss_sold_date_sk = d.d_date_sk\nLEFT JOIN store_returns sr\n  ON ss.ss_ticket_number = sr.sr_ticket_number\n AND ss.ss_item_sk = sr.sr_item_sk\nWHERE d.d_year = 2001 AND d.d_moy = 2"
              }
            ],
            "fact": "store_sales",
            "filters": {},
            "grain": [
              "ss_ticket_number",
              "ss_item_sk"
            ],
            "joins": [
              {
                "cardinality": "1:1",
